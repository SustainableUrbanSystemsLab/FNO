                    <item name="AdditionalSource" type_name="gh_string" type_code="10">
  int _NSamples;
  int _NVariables;
  int _Seed;
  Random r ;
  DataTree&lt;double&gt; inputs;
  double[,] matrix;


  double[,] RandLatinHypercube(int n, int k)
  {
    double[,] X = new double[n, k];
    for (int i = 0; i &lt; k; i++)
    {
      double[] v = new double[n];

      for (int j = 0; j &lt; n; j++)
      {
        v[j] = j;
      }
      v = this.Shuffle(v);

      //SetColumn;
      for (int j = 0; j &lt; n; j++)
      {
        X[j, i] = v[j];
      }
    }

    double[,] array1 = new double[n, k];
    double[,] array2 = new double[n, k];

    for (int i = 0; i &lt; n; i++)
    {
      for (int j = 0; j &lt; k; j++)
      {
        array1[i, j] = 0.5;
        array2[i, j] = n;
      }
    }

    //Add
    for (int i = 0; i &lt; n; i++)
    {
      for (int j = 0; j &lt; k; j++)
      {
        X[i, j] = X[i, j] + array1[i, j];
      }
    }

    //PointwiseDivide
    for (int i = 0; i &lt; n; i++)
    {
      for (int j = 0; j &lt; k; j++)
      {
        X[i, j] = X[i, j] / array2[i, j];
      }
    }
    return X;
  }


  private double[] Shuffle(double[] v)
  {
    int n = v.Length;
    while (n &gt; 1)
    {
      n--;
      int k = r.Next(n + 1);
      double value = v[k];
      v[k] = v[n];
      v[n] = value;
    }
    return v;
  }


  public static T[] GetCol&lt;T&gt;(T[,] matrix, int col)
  {
  var rows = matrix.GetLength(0);
  var array = new T[rows];
  for (int i = 0; i &lt; rows; ++i)
  array[i] = matrix[ i, col];
  return array;
}


public static T[] GetRow&lt;T&gt;(T[,] matrix, int row)
  {
  var columns = matrix.GetLength(1);
var array = new T[columns];
for (int i = 0; i &lt; columns; ++i)
array[i] = matrix[row, i];
  return array;
}
</item>
                    <item name="CustomUsing" type_name="gh_bool" type_code="1">true</item>
                    <item name="Description" type_name="gh_string" type_code="10">A C#.NET scriptable component</item>
                    <item name="EditorPosition" type_name="gh_drawing_point" type_code="30">
                      <X>31</X>
                      <Y>101</Y>
                    </item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
                    <item name="IconDisplay" type_name="gh_int32" type_code="3">1</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">05cae7e2-0b12-43b2-b998-fb989f9646c9</item>
                    <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">LHC</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">true</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    //run for the first time
    if(r == null) {
      _NSamples = NSamples;
      _NVariables = NVariables;
      _Seed = seed;

      r = new Random(seed);
      inputs = new DataTree&lt;double&gt;();
      matrix = RandLatinHypercube(NSamples, NVariables);
      for (int i = 0; i &lt; NSamples; i++)
      {
        var row = GetRow(matrix, i);
        inputs.AddRange(row, new GH_Path(i));
      }
    }
      //sampling inputs changed
    else{
      if(NSamples != _NSamples || _NVariables != NVariables || _Seed != seed){
        _NSamples = NSamples;
        _NVariables = NVariables;
        _Seed = seed;

        r = new Random(seed);
        inputs = new DataTree&lt;double&gt;();
        matrix = RandLatinHypercube(NSamples, NVariables);
        for (int i = 0; i &lt; NSamples; i++)
        {
          var row = GetRow(matrix, i);
          inputs.AddRange(row, new GH_Path(i));
        }
      }
    }



    // just in case this gets too heavy for the canvas
    if(all){  All = inputs; }


    //List&lt;double&gt; vals = new List&lt;double&gt;();
    //foreach(var b in inputs.Branches){
      //vals.Add(b[iter]);
    //}

    Iter = inputs.Branches[iter];
